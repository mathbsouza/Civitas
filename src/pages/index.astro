---
import BaseLayout from "../components/BaseLayout.astro";
import PostExplorer from "../components/PostExplorer";
import { getPostCover, getPostPath, getPublishedPosts, toPostSummary } from "../lib/posts";
import { SITE, withBase } from "../lib/site";

const posts = await getPublishedPosts();
const summaries = posts.map((post) => toPostSummary(post, withBase(getPostCover(post)), withBase(getPostPath(post))));
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-lockup">
      <h1 id="home-title">Civitas</h1>
      <div class="ornamental-divider" aria-hidden="true"><span></span></div>
      <p>por {SITE.author}</p>
    </div>
  </section>

  <section class="home-welcome">
    <div class="section-shell prose-intro">
      <h2>Bem-vindo ao Civitas</h2>
      <p>{SITE.description}</p>
      <p>Ensaios para leitura lenta, consulta e debate sobre as ideias e instituições que organizam a vida comum.</p>
    </div>
  </section>

  <section class="home-archive" id="arquivo">
    <div class="section-shell">
      <h2>Arquivo cronológico</h2>
      <PostExplorer client:load posts={summaries} />
    </div>
  </section>
</BaseLayout>
