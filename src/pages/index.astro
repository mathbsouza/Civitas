---
import BaseLayout from "../components/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPublishedPosts } from "../lib/posts";
import { SITE } from "../lib/site";

const posts = await getPublishedPosts();
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <section class="home-hero" aria-labelledby="civitas-title">
    <div>
      <h1 class="wordmark" id="civitas-title">Civitas</h1>
      <span class="hero-glyph" aria-hidden="true"></span>
    </div>
  </section>

  <section class="feed" aria-label="Textos recentes">
    <div class="feed-grid">
      {posts.slice(0, 7).map((post, index) => <PostCard post={post} index={index + 1} />)}
    </div>
  </section>
</BaseLayout>
