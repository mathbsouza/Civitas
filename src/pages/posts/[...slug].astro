---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import PostMeta from "../../components/PostMeta.astro";
import { formatDate, getPostCover, getPostPath, getPostSlug, getPublishedPosts, getReadingTime } from "../../lib/posts";
import { withBase } from "../../lib/site";

export async function getStaticPaths() {
  return (await getCollection("posts"))
    .filter((post) => post.data.published)
    .map((post) => ({ params: { slug: getPostSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const posts = await getPublishedPosts();
const current = posts.findIndex((entry) => entry.id === post.id);
const previous = posts[current + 1];
const next = posts[current - 1];
---

<BaseLayout title={post.data.title} description={post.data.subtitle ?? post.data.excerpt} image={getPostCover(post)}>
  <article class="longform-article">
    <header class="article-header">
      <div class="article-heading">
        <h1 class="article-title">{post.data.title}</h1>
        {post.data.subtitle && <p class="article-subtitle">{post.data.subtitle}</p>}
        <PostMeta author={post.data.author} dateTime={post.data.date.toISOString()} displayDate={formatDate(post.data.date)} readingTime={getReadingTime(post.body)} />
        <section
          class="article-share"
          aria-label="Compartilhar artigo"
          data-share-title={post.data.title}
          data-share-author={post.data.author}
        >
          <details class="article-share-menu">
            <summary>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="18" cy="5" r="2.5"></circle>
                <circle cx="6" cy="12" r="2.5"></circle>
                <circle cx="18" cy="19" r="2.5"></circle>
                <path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5"></path>
              </svg>
              <span>Compartilhar</span>
            </summary>
            <div class="article-share-options">
              <a class="article-share-option" data-share-whatsapp href="#" target="_blank" rel="noopener noreferrer">
                <span class="share-format-mark">WA</span>
                <span><strong>WhatsApp</strong><small>Enviar o link</small></span>
              </a>
              <button class="article-share-option" type="button" data-share-image="feed">
                <span class="share-format-mark share-format-feed" aria-hidden="true"></span>
                <span><strong>Instagram Feed</strong><small>1080 × 1080 · link incluído</small></span>
              </button>
              <button class="article-share-option" type="button" data-share-image="story">
                <span class="share-format-mark share-format-story" aria-hidden="true"></span>
                <span><strong>Instagram Story</strong><small>1080 × 1920 · link incluído</small></span>
              </button>
              <p class="article-share-status" role="status" aria-live="polite"></p>
            </div>
          </details>
        </section>
      </div>
    </header>

    {post.data.cover && <figure class="article-cover"><img src={withBase(getPostCover(post))} alt="" loading="eager" /></figure>}

    <button class="reader-guide-trigger" type="button" aria-expanded="false" aria-controls="reader-guide" aria-label="Expandir sumário">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
      <span>Sumário</span>
    </button>
    <button class="reader-guide-scrim" type="button" tabindex="-1" aria-label="Fechar sumário"></button>
    <aside class="reader-guide" id="reader-guide" aria-hidden="true" inert>
      <div class="reader-guide-head">
        <div><span>Neste texto</span><small class="reader-guide-count"></small></div>
        <button class="reader-guide-close" type="button" aria-label="Recolher sumário">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
        </button>
      </div>
      <nav aria-label="Sumário do texto">
        <ol class="reader-guide-list"></ol>
      </nav>
    </aside>

    <div class="reader-shell">
      <div class="article-content"><Content /></div>
    </div>

  </article>

  <nav class="article-nav" aria-label="Textos adjacentes">
    {previous ? <a href={withBase(getPostPath(previous))}><small>Anterior</small><strong>{previous.data.title}</strong></a> : <span></span>}
    {next ? <a class="nav-next" href={withBase(getPostPath(next))}><small>Próximo</small><strong>{next.data.title}</strong></a> : <span></span>}
  </nav>
</BaseLayout>

<script>
  const content = document.querySelector<HTMLElement>(".article-content");
  const guide = document.querySelector<HTMLElement>(".reader-guide");
  const guideTrigger = document.querySelector<HTMLButtonElement>(".reader-guide-trigger");
  const guideClose = document.querySelector<HTMLButtonElement>(".reader-guide-close");
  const guideScrim = document.querySelector<HTMLButtonElement>(".reader-guide-scrim");
  const guideList = document.querySelector<HTMLOListElement>(".reader-guide-list");
  const guideCount = document.querySelector<HTMLElement>(".reader-guide-count");
  const desktopGuide = window.matchMedia("(min-width: 1180px)");

  const setGuide = (open: boolean, remember = true) => {
    document.body.classList.toggle("reader-guide-open", open);
    guideTrigger?.setAttribute("aria-expanded", String(open));
    guideTrigger?.setAttribute("aria-label", open ? "Recolher sumário" : "Expandir sumário");
    guide?.setAttribute("aria-hidden", String(!open));
    if (guide) guide.inert = !open;
    if (remember && desktopGuide.matches) localStorage.setItem("civitas-reader-guide", open ? "open" : "closed");
  };

  const headings = content
    ? Array.from(content.querySelectorAll<HTMLHeadingElement>("h1, h2, h3"))
    : [];

  headings.forEach((heading, index) => {
    if (!heading.id) heading.id = `secao-${index + 1}`;
    const item = document.createElement("li");
    item.dataset.level = heading.tagName.slice(1);
    const link = document.createElement("a");
    link.href = `#${heading.id}`;
    link.textContent = heading.textContent;
    link.addEventListener("click", () => {
      if (!desktopGuide.matches) setGuide(false, false);
    });
    item.appendChild(link);
    guideList?.appendChild(item);
  });

  if (guideCount) guideCount.textContent = `${headings.length} seções`;

  guideTrigger?.addEventListener("click", () => setGuide(guideTrigger.getAttribute("aria-expanded") !== "true"));
  guideClose?.addEventListener("click", () => {
    setGuide(false);
    guideTrigger?.focus();
  });
  guideScrim?.addEventListener("click", () => setGuide(false, false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && document.body.classList.contains("reader-guide-open")) {
      setGuide(false, false);
      guideTrigger?.focus();
    }
  });

  const syncGuideMode = () => {
    const shouldOpen = desktopGuide.matches && localStorage.getItem("civitas-reader-guide") !== "closed";
    setGuide(shouldOpen, false);
  };
  desktopGuide.addEventListener("change", syncGuideMode);
  syncGuideMode();

  const updateActiveSection = () => {
    let active = headings[0];
    headings.forEach((heading) => {
      if (heading.getBoundingClientRect().top <= 150) active = heading;
    });
    guideList?.querySelectorAll("a").forEach((link) => {
      link.classList.toggle("is-active", link.getAttribute("href") === `#${active?.id}`);
    });
  };
  window.addEventListener("scroll", updateActiveSection, { passive: true });
  updateActiveSection();

  content?.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach((link) => {
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    if (!link.closest(".footnotes")) link.classList.add("source-link");
  });

  const shareSection = document.querySelector<HTMLElement>(".article-share");
  const shareMenu = shareSection?.querySelector<HTMLDetailsElement>(".article-share-menu");
  const shareStatus = shareSection?.querySelector<HTMLElement>(".article-share-status");
  const whatsappLink = shareSection?.querySelector<HTMLAnchorElement>("[data-share-whatsapp]");
  const imageShareButtons = shareSection?.querySelectorAll<HTMLButtonElement>("[data-share-image]") ?? [];
  const sharedTitle = shareSection?.dataset.shareTitle ?? document.title;
  const sharedAuthor = shareSection?.dataset.shareAuthor ?? "Civitas";
  const sharedUrl = window.location.href.split(/[?#]/)[0];
  const sharedDisplayUrl = sharedUrl.replace(/^https?:\/\//, "").replace(/\/$/, "");

  if (whatsappLink) {
    const message = `Leia “${sharedTitle}” no Civitas:\n${sharedUrl}`;
    whatsappLink.href = `https://wa.me/?text=${encodeURIComponent(message)}`;
    whatsappLink.addEventListener("click", () => shareMenu?.removeAttribute("open"));
  }

  type ShareFormat = "feed" | "story";

  const wrapCanvasText = (context: CanvasRenderingContext2D, text: string, maxWidth: number) => {
    const words = text.trim().split(/\s+/);
    const lines: string[] = [];
    let line = "";

    words.forEach((word) => {
      const candidate = line ? `${line} ${word}` : word;
      if (line && context.measureText(candidate).width > maxWidth) {
        lines.push(line);
        line = word;
      } else {
        line = candidate;
      }
    });
    if (line) lines.push(line);
    return lines;
  };

  const fitCanvasTitle = (
    context: CanvasRenderingContext2D,
    title: string,
    maxWidth: number,
    maxLines: number,
    initialSize: number,
  ) => {
    for (let size = initialSize; size >= 52; size -= 4) {
      context.font = `600 ${size}px Georgia, serif`;
      const lines = wrapCanvasText(context, title, maxWidth);
      if (lines.length <= maxLines) return { lines, size };
    }

    context.font = "600 52px Georgia, serif";
    const lines = wrapCanvasText(context, title, maxWidth).slice(0, maxLines);
    const lastIndex = lines.length - 1;
    if (lastIndex >= 0) {
      while (context.measureText(`${lines[lastIndex]}…`).width > maxWidth && lines[lastIndex].includes(" ")) {
        lines[lastIndex] = lines[lastIndex].replace(/\s+\S+$/, "");
      }
      lines[lastIndex] = `${lines[lastIndex]}…`;
    }
    return { lines, size: 52 };
  };

  const wrapCanvasUrl = (context: CanvasRenderingContext2D, url: string, maxWidth: number) => {
    const parts = url.split("/");
    const lines: string[] = [];
    let line = parts.shift() ?? "";

    parts.forEach((part) => {
      const candidate = `${line}/${part}`;
      if (line && context.measureText(candidate).width > maxWidth) {
        lines.push(line);
        line = part;
      } else {
        line = candidate;
      }
    });
    if (line) lines.push(line);
    return lines;
  };

  const createShareArtwork = async (format: ShareFormat) => {
    const story = format === "story";
    const width = 1080;
    const height = story ? 1920 : 1080;
    const frame = story ? 70 : 54;
    const padding = story ? 118 : 94;
    const canvas = document.createElement("canvas");
    canvas.width = width;
    canvas.height = height;
    const context = canvas.getContext("2d");
    if (!context) throw new Error("Canvas indisponível");

    await document.fonts?.ready;
    context.fillStyle = "#f3efe5";
    context.fillRect(0, 0, width, height);
    context.strokeStyle = "#171717";
    context.lineWidth = 3;
    context.strokeRect(frame, frame, width - frame * 2, height - frame * 2);

    context.textBaseline = "top";
    context.textAlign = "center";
    context.fillStyle = "#171717";
    context.font = `700 ${story ? 58 : 52}px Georgia, serif`;
    context.fillText("CIVITAS", width / 2, story ? 148 : 112);

    const diamondY = story ? 248 : 202;
    context.save();
    context.translate(width / 2, diamondY);
    context.rotate(Math.PI / 4);
    context.fillRect(-7, -7, 14, 14);
    context.restore();

    context.font = `600 ${story ? 23 : 21}px Arial, sans-serif`;
    context.fillStyle = "#625d54";
    context.fillText("ENSAIO · POLÍTICA E VIDA PÚBLICA", width / 2, diamondY + 50);

    const maxTitleWidth = width - padding * 2;
    const title = fitCanvasTitle(context, sharedTitle, maxTitleWidth, story ? 7 : 5, story ? 118 : 102);
    const lineHeight = title.size * 1.08;
    const titleHeight = title.lines.length * lineHeight;
    const titleAreaTop = story ? 520 : 320;
    const titleAreaBottom = story ? 1340 : 710;
    const titleTop = titleAreaTop + (titleAreaBottom - titleAreaTop - titleHeight) / 2;

    context.fillStyle = "#171717";
    context.font = `600 ${title.size}px Georgia, serif`;
    title.lines.forEach((line, index) => context.fillText(line, width / 2, titleTop + index * lineHeight));

    const authorY = story ? 1430 : 755;
    context.fillRect(width / 2 - 32, authorY - 34, 64, 3);
    context.font = `600 ${story ? 25 : 22}px Arial, sans-serif`;
    context.fillText(sharedAuthor.toUpperCase(), width / 2, authorY);

    const linkBandTop = story ? 1580 : 842;
    context.fillStyle = "#171717";
    context.fillRect(frame, linkBandTop, width - frame * 2, height - frame - linkBandTop);
    context.fillStyle = "#f3efe5";
    context.font = `600 ${story ? 21 : 19}px Arial, sans-serif`;
    context.fillText("LEIA O TEXTO COMPLETO", width / 2, linkBandTop + (story ? 62 : 38));
    context.font = `400 ${story ? 21 : 18}px Arial, sans-serif`;
    const urlLines = wrapCanvasUrl(context, sharedDisplayUrl, width - padding * 2);
    const urlTop = linkBandTop + (story ? 116 : 79);
    urlLines.forEach((line, index) => context.fillText(line, width / 2, urlTop + index * (story ? 31 : 27)));

    return new Promise<Blob>((resolve, reject) => {
      canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error("Falha ao gerar a imagem")), "image/png");
    });
  };

  const downloadArtwork = (file: File) => {
    const objectUrl = URL.createObjectURL(file);
    const download = document.createElement("a");
    download.href = objectUrl;
    download.download = file.name;
    document.body.appendChild(download);
    download.click();
    download.remove();
    window.setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
  };

  const sharedSlug = sharedTitle
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
  const preparedArtwork = new Map<ShareFormat, File>();

  if (shareStatus) shareStatus.textContent = "Preparando as artes…";
  const artworkJobs = Array.from(imageShareButtons).map(async (button) => {
    const format = button.dataset.shareImage as ShareFormat;
    button.disabled = true;
    try {
      const blob = await createShareArtwork(format);
      preparedArtwork.set(format, new File([blob], `civitas-${sharedSlug}-${format}.png`, { type: "image/png" }));
      button.disabled = false;
    } catch {
      button.dataset.shareError = "true";
    }
  });

  Promise.allSettled(artworkJobs).then(() => {
    if (!shareStatus) return;
    shareStatus.textContent = preparedArtwork.size === imageShareButtons.length
      ? ""
      : "Uma das artes não pôde ser preparada neste navegador.";
  });

  imageShareButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const format = button.dataset.shareImage as ShareFormat;
      const label = format === "story" ? "Story" : "Feed";
      const file = preparedArtwork.get(format);
      if (!file) {
        if (shareStatus) shareStatus.textContent = `A arte para ${label} ainda está sendo preparada.`;
        return;
      }

      const supportsFileShare = typeof navigator.share === "function"
        && typeof navigator.canShare === "function"
        && navigator.canShare({ files: [file] });

      if (supportsFileShare) {
        button.disabled = true;
        if (shareStatus) shareStatus.textContent = `Abrindo opções para compartilhar no ${label}…`;
        navigator.share({ title: sharedTitle, files: [file] })
          .then(() => {
            if (shareStatus) shareStatus.textContent = `Arte para ${label} compartilhada.`;
            shareMenu?.removeAttribute("open");
          })
          .catch((error) => {
            if (error instanceof DOMException && error.name === "AbortError") {
              if (shareStatus) shareStatus.textContent = "Compartilhamento cancelado.";
            } else if (shareStatus) {
              shareStatus.textContent = "O Instagram não aceitou o envio. A imagem será baixada.";
              downloadArtwork(file);
            }
          })
          .finally(() => { button.disabled = false; });
        return;
      }

      downloadArtwork(file);
      navigator.clipboard?.writeText(sharedUrl).catch(() => undefined);
      if (shareStatus) shareStatus.textContent = `Arte para ${label} baixada. Abra-a no Instagram.`;
      shareMenu?.removeAttribute("open");
    });
  });

  document.addEventListener("click", (event) => {
    if (shareMenu?.open && !shareMenu.contains(event.target as Node)) shareMenu.removeAttribute("open");
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && shareMenu?.open) shareMenu.removeAttribute("open");
  });

  const footnotes = content?.querySelector<HTMLElement>(".footnotes");
  const footnoteItems = footnotes
    ? Array.from(footnotes.querySelectorAll<HTMLElement>(":scope > ol > li"))
    : [];
  const footnoteCount = footnoteItems.length;

  if (footnotes && footnoteCount) {
    footnotes.dataset.count = `${footnoteCount} referências · ordem de citação`;
    const label = footnotes.querySelector<HTMLElement>("#footnote-label");
    if (label) label.textContent = "Referências";
  }

  footnoteItems.forEach((reference, index) => {
    reference.dataset.referenceNumber = String(index + 1);
    reference.dataset.referenceTag = decodeURIComponent(reference.id.replace(/^user-content-fn-/, ""));
  });

  if (footnotes && footnoteCount) {
    const citationPreview = document.createElement("aside");
    citationPreview.className = "citation-preview";
    citationPreview.id = "citation-preview";
    citationPreview.setAttribute("aria-hidden", "true");
    citationPreview.innerHTML = `
      <div class="citation-preview-head">
        <strong class="citation-preview-label"></strong>
        <span class="citation-preview-tag"></span>
      </div>
      <div class="citation-preview-body"></div>
    `;
    document.body.appendChild(citationPreview);

    const previewLabel = citationPreview.querySelector<HTMLElement>(".citation-preview-label");
    const previewTag = citationPreview.querySelector<HTMLElement>(".citation-preview-tag");
    const previewBody = citationPreview.querySelector<HTMLElement>(".citation-preview-body");
    const hoverCapable = window.matchMedia("(hover: hover) and (pointer: fine)");
    let activeCitation: HTMLAnchorElement | null = null;
    let closeTimer: number | undefined;

    const referenceFor = (citation: HTMLAnchorElement) => {
      const target = citation.getAttribute("href");
      return target?.startsWith("#") ? document.getElementById(target.slice(1)) : null;
    };

    const positionPreview = () => {
      if (!activeCitation || window.innerWidth <= 640) return;
      const citationRect = activeCitation.getBoundingClientRect();
      const previewRect = citationPreview.getBoundingClientRect();
      const gutter = 12;
      const left = Math.min(
        window.innerWidth - previewRect.width - gutter,
        Math.max(gutter, citationRect.left + citationRect.width / 2 - previewRect.width / 2),
      );
      let top = citationRect.bottom + 10;
      if (top + previewRect.height > window.innerHeight - gutter) {
        top = Math.max(gutter, citationRect.top - previewRect.height - 10);
      }
      citationPreview.style.left = `${left}px`;
      citationPreview.style.top = `${top}px`;
    };

    const closePreview = () => {
      if (closeTimer !== undefined) window.clearTimeout(closeTimer);
      activeCitation?.setAttribute("aria-expanded", "false");
      activeCitation = null;
      citationPreview.classList.remove("is-open");
      citationPreview.setAttribute("aria-hidden", "true");
    };

    const scheduleClose = () => {
      closeTimer = window.setTimeout(closePreview, 180);
    };

    const openPreview = (citation: HTMLAnchorElement) => {
      const reference = referenceFor(citation);
      if (!reference || !previewBody) return;
      if (closeTimer !== undefined) window.clearTimeout(closeTimer);

      activeCitation?.setAttribute("aria-expanded", "false");
      activeCitation = citation;
      citation.setAttribute("aria-expanded", "true");

      const number = citation.textContent?.trim() || reference.dataset.referenceNumber || "";
      const tag = reference.dataset.referenceTag || "fonte";
      if (previewLabel) previewLabel.textContent = `Referência ${number}`;
      if (previewTag) previewTag.textContent = `#${tag}`;

      const fullReference = reference.querySelector("p")?.cloneNode(true) as HTMLElement | undefined;
      fullReference?.querySelectorAll("[data-footnote-backref]").forEach((backlink) => backlink.remove());
      previewBody.replaceChildren(fullReference ?? reference.cloneNode(true));

      citationPreview.classList.add("is-open");
      citationPreview.setAttribute("aria-hidden", "false");
      requestAnimationFrame(positionPreview);
    };

    const citations = Array.from(content?.querySelectorAll<HTMLAnchorElement>("a[data-footnote-ref]") ?? []);
    citations.forEach((citation) => {
      citation.classList.add("vancouver-citation");
      citation.setAttribute("aria-controls", citationPreview.id);
      citation.setAttribute("aria-expanded", "false");
      citation.setAttribute("aria-label", `Referência ${citation.textContent?.trim()}. Passe o cursor para ver a fonte completa.`);
      citation.addEventListener("pointerenter", () => openPreview(citation));
      citation.addEventListener("pointerleave", scheduleClose);
      citation.addEventListener("focus", () => openPreview(citation));
      citation.addEventListener("blur", scheduleClose);
      citation.addEventListener("click", (event) => {
        if (!hoverCapable.matches) {
          event.preventDefault();
          activeCitation === citation && citationPreview.classList.contains("is-open")
            ? closePreview()
            : openPreview(citation);
        } else {
          closePreview();
        }
      });
    });

    citationPreview.addEventListener("pointerenter", () => {
      if (closeTimer !== undefined) window.clearTimeout(closeTimer);
    });
    citationPreview.addEventListener("pointerleave", scheduleClose);
    citationPreview.addEventListener("focusin", () => {
      if (closeTimer !== undefined) window.clearTimeout(closeTimer);
    });
    citationPreview.addEventListener("focusout", scheduleClose);
    document.addEventListener("pointerdown", (event) => {
      const target = event.target as Node;
      if (activeCitation && !citationPreview.contains(target) && !activeCitation.contains(target)) closePreview();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && activeCitation) closePreview();
    });
    window.addEventListener("resize", positionPreview, { passive: true });
    window.addEventListener("scroll", closePreview, { passive: true });
  }
</script>
