---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import PostMeta from "../../components/PostMeta.astro";
import { formatDate, getPostCover, getPostPath, getPostSlug, getPublishedPosts, getReadingTime } from "../../lib/posts";
import { withBase } from "../../lib/site";

export async function getStaticPaths() {
  return (await getCollection("posts"))
    .filter((post) => post.data.published)
    .map((post) => ({ params: { slug: getPostSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const posts = await getPublishedPosts();
const current = posts.findIndex((entry) => entry.id === post.id);
const previous = posts[current + 1];
const next = posts[current - 1];
---

<BaseLayout title={post.data.title} description={post.data.subtitle ?? post.data.excerpt} image={getPostCover(post)}>
  <article class="longform-article">
    <header class="article-header">
      <div class="article-heading">
        <h1 class="article-title">{post.data.title}</h1>
        {post.data.subtitle && <p class="article-subtitle">{post.data.subtitle}</p>}
        <PostMeta author={post.data.author} dateTime={post.data.date.toISOString()} displayDate={formatDate(post.data.date)} readingTime={getReadingTime(post.body)} />
      </div>
    </header>

    {post.data.cover && <figure class="article-cover"><img src={withBase(getPostCover(post))} alt="" loading="eager" /></figure>}

    <button class="reader-guide-trigger" type="button" aria-expanded="false" aria-controls="reader-guide" aria-label="Expandir sumário">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
      <span>Sumário</span>
    </button>
    <button class="reader-guide-scrim" type="button" tabindex="-1" aria-label="Fechar sumário"></button>
    <aside class="reader-guide" id="reader-guide" aria-hidden="true" inert>
      <div class="reader-guide-head">
        <div><span>Neste texto</span><small class="reader-guide-count"></small></div>
        <button class="reader-guide-close" type="button" aria-label="Recolher sumário">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
        </button>
      </div>
      <nav aria-label="Sumário do texto">
        <ol class="reader-guide-list"></ol>
      </nav>
    </aside>

    <div class="reader-shell">
      <div class="article-content"><Content /></div>
    </div>
  </article>

  <nav class="article-nav" aria-label="Textos adjacentes">
    {previous ? <a href={withBase(getPostPath(previous))}><small>Anterior</small><strong>{previous.data.title}</strong></a> : <span></span>}
    {next ? <a class="nav-next" href={withBase(getPostPath(next))}><small>Próximo</small><strong>{next.data.title}</strong></a> : <span></span>}
  </nav>
</BaseLayout>

<script>
  const content = document.querySelector<HTMLElement>(".article-content");
  const guide = document.querySelector<HTMLElement>(".reader-guide");
  const guideTrigger = document.querySelector<HTMLButtonElement>(".reader-guide-trigger");
  const guideClose = document.querySelector<HTMLButtonElement>(".reader-guide-close");
  const guideScrim = document.querySelector<HTMLButtonElement>(".reader-guide-scrim");
  const guideList = document.querySelector<HTMLOListElement>(".reader-guide-list");
  const guideCount = document.querySelector<HTMLElement>(".reader-guide-count");
  const desktopGuide = window.matchMedia("(min-width: 1180px)");

  const setGuide = (open: boolean, remember = true) => {
    document.body.classList.toggle("reader-guide-open", open);
    guideTrigger?.setAttribute("aria-expanded", String(open));
    guideTrigger?.setAttribute("aria-label", open ? "Recolher sumário" : "Expandir sumário");
    guide?.setAttribute("aria-hidden", String(!open));
    if (guide) guide.inert = !open;
    if (remember && desktopGuide.matches) localStorage.setItem("civitas-reader-guide", open ? "open" : "closed");
  };

  const headings = content
    ? Array.from(content.querySelectorAll<HTMLHeadingElement>("h1, h2, h3"))
    : [];

  headings.forEach((heading, index) => {
    if (!heading.id) heading.id = `secao-${index + 1}`;
    const item = document.createElement("li");
    item.dataset.level = heading.tagName.slice(1);
    const link = document.createElement("a");
    link.href = `#${heading.id}`;
    link.textContent = heading.textContent;
    link.addEventListener("click", () => {
      if (!desktopGuide.matches) setGuide(false, false);
    });
    item.appendChild(link);
    guideList?.appendChild(item);
  });

  if (guideCount) guideCount.textContent = `${headings.length} seções`;

  guideTrigger?.addEventListener("click", () => setGuide(guideTrigger.getAttribute("aria-expanded") !== "true"));
  guideClose?.addEventListener("click", () => {
    setGuide(false);
    guideTrigger?.focus();
  });
  guideScrim?.addEventListener("click", () => setGuide(false, false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && document.body.classList.contains("reader-guide-open")) {
      setGuide(false, false);
      guideTrigger?.focus();
    }
  });

  const syncGuideMode = () => {
    const shouldOpen = desktopGuide.matches && localStorage.getItem("civitas-reader-guide") !== "closed";
    setGuide(shouldOpen, false);
  };
  desktopGuide.addEventListener("change", syncGuideMode);
  syncGuideMode();

  const updateActiveSection = () => {
    let active = headings[0];
    headings.forEach((heading) => {
      if (heading.getBoundingClientRect().top <= 150) active = heading;
    });
    guideList?.querySelectorAll("a").forEach((link) => {
      link.classList.toggle("is-active", link.getAttribute("href") === `#${active?.id}`);
    });
  };
  window.addEventListener("scroll", updateActiveSection, { passive: true });
  updateActiveSection();

  content?.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach((link) => {
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    if (!link.closest(".footnotes")) link.classList.add("source-link");
  });

  const footnotes = content?.querySelector<HTMLElement>(".footnotes");
  const footnoteItems = footnotes
    ? Array.from(footnotes.querySelectorAll<HTMLElement>(":scope > ol > li"))
    : [];
  const footnoteCount = footnoteItems.length;

  if (footnotes && footnoteCount) {
    footnotes.dataset.count = `${footnoteCount} referências · ordem de citação`;
    const label = footnotes.querySelector<HTMLElement>("#footnote-label");
    if (label) label.textContent = "Referências";
  }

  footnoteItems.forEach((reference, index) => {
    reference.dataset.referenceNumber = String(index + 1);
    reference.dataset.referenceTag = decodeURIComponent(reference.id.replace(/^user-content-fn-/, ""));
  });

  if (footnotes && footnoteCount) {
    const citationPreview = document.createElement("aside");
    citationPreview.className = "citation-preview";
    citationPreview.id = "citation-preview";
    citationPreview.setAttribute("aria-hidden", "true");
    citationPreview.innerHTML = `
      <div class="citation-preview-head">
        <strong class="citation-preview-label"></strong>
        <span class="citation-preview-tag"></span>
      </div>
      <div class="citation-preview-body"></div>
    `;
    document.body.appendChild(citationPreview);

    const previewLabel = citationPreview.querySelector<HTMLElement>(".citation-preview-label");
    const previewTag = citationPreview.querySelector<HTMLElement>(".citation-preview-tag");
    const previewBody = citationPreview.querySelector<HTMLElement>(".citation-preview-body");
    const hoverCapable = window.matchMedia("(hover: hover) and (pointer: fine)");
    let activeCitation: HTMLAnchorElement | null = null;
    let closeTimer: number | undefined;

    const referenceFor = (citation: HTMLAnchorElement) => {
      const target = citation.getAttribute("href");
      return target?.startsWith("#") ? document.getElementById(target.slice(1)) : null;
    };

    const positionPreview = () => {
      if (!activeCitation || window.innerWidth <= 640) return;
      const citationRect = activeCitation.getBoundingClientRect();
      const previewRect = citationPreview.getBoundingClientRect();
      const gutter = 12;
      const left = Math.min(
        window.innerWidth - previewRect.width - gutter,
        Math.max(gutter, citationRect.left + citationRect.width / 2 - previewRect.width / 2),
      );
      let top = citationRect.bottom + 10;
      if (top + previewRect.height > window.innerHeight - gutter) {
        top = Math.max(gutter, citationRect.top - previewRect.height - 10);
      }
      citationPreview.style.left = `${left}px`;
      citationPreview.style.top = `${top}px`;
    };

    const closePreview = () => {
      if (closeTimer !== undefined) window.clearTimeout(closeTimer);
      activeCitation?.setAttribute("aria-expanded", "false");
      activeCitation = null;
      citationPreview.classList.remove("is-open");
      citationPreview.setAttribute("aria-hidden", "true");
    };

    const scheduleClose = () => {
      closeTimer = window.setTimeout(closePreview, 180);
    };

    const openPreview = (citation: HTMLAnchorElement) => {
      const reference = referenceFor(citation);
      if (!reference || !previewBody) return;
      if (closeTimer !== undefined) window.clearTimeout(closeTimer);

      activeCitation?.setAttribute("aria-expanded", "false");
      activeCitation = citation;
      citation.setAttribute("aria-expanded", "true");

      const number = citation.textContent?.trim() || reference.dataset.referenceNumber || "";
      const tag = reference.dataset.referenceTag || "fonte";
      if (previewLabel) previewLabel.textContent = `Referência ${number}`;
      if (previewTag) previewTag.textContent = `#${tag}`;

      const fullReference = reference.querySelector("p")?.cloneNode(true) as HTMLElement | undefined;
      fullReference?.querySelectorAll("[data-footnote-backref]").forEach((backlink) => backlink.remove());
      previewBody.replaceChildren(fullReference ?? reference.cloneNode(true));

      citationPreview.classList.add("is-open");
      citationPreview.setAttribute("aria-hidden", "false");
      requestAnimationFrame(positionPreview);
    };

    const citations = Array.from(content?.querySelectorAll<HTMLAnchorElement>("a[data-footnote-ref]") ?? []);
    citations.forEach((citation) => {
      citation.classList.add("vancouver-citation");
      citation.setAttribute("aria-controls", citationPreview.id);
      citation.setAttribute("aria-expanded", "false");
      citation.setAttribute("aria-label", `Referência ${citation.textContent?.trim()}. Passe o cursor para ver a fonte completa.`);
      citation.addEventListener("pointerenter", () => openPreview(citation));
      citation.addEventListener("pointerleave", scheduleClose);
      citation.addEventListener("focus", () => openPreview(citation));
      citation.addEventListener("blur", scheduleClose);
      citation.addEventListener("click", (event) => {
        if (!hoverCapable.matches) {
          event.preventDefault();
          activeCitation === citation && citationPreview.classList.contains("is-open")
            ? closePreview()
            : openPreview(citation);
        } else {
          closePreview();
        }
      });
    });

    citationPreview.addEventListener("pointerenter", () => {
      if (closeTimer !== undefined) window.clearTimeout(closeTimer);
    });
    citationPreview.addEventListener("pointerleave", scheduleClose);
    citationPreview.addEventListener("focusin", () => {
      if (closeTimer !== undefined) window.clearTimeout(closeTimer);
    });
    citationPreview.addEventListener("focusout", scheduleClose);
    document.addEventListener("pointerdown", (event) => {
      const target = event.target as Node;
      if (activeCitation && !citationPreview.contains(target) && !activeCitation.contains(target)) closePreview();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && activeCitation) closePreview();
    });
    window.addEventListener("resize", positionPreview, { passive: true });
    window.addEventListener("scroll", closePreview, { passive: true });
  }
</script>
